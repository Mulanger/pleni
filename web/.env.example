# Frontend environment. Every value here ships inside the browser bundle.
# Server secrets (Clerk secret key, Supabase secret/service key, Bunny API key)
# must NEVER be added to this file or to any VITE_* variable.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Clerk publishable key. Public by design.
# Development instance: pk_test_...  Production instance: pk_live_...
# Leave empty to run the app with no authentication; the anonymous feed keeps working.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# Off by default. Enabling before the matching database/functions deploy makes
# the app fail closed to Senaste rather than storing preferences locally.
VITE_RECOMMENDATIONS_ENABLED=false
