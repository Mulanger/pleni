# Frontend environment. Every value here ships inside the browser bundle.
# Server secrets (Clerk secret key, Supabase secret/service key, Bunny API key)
# must NEVER be added to this file or to any VITE_* variable.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Clerk publishable key. Public by design.
# Development instance: pk_test_...  Production instance: pk_live_...
# Leave empty to run the app with no authentication; the anonymous feed keeps working.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# Released after migrations 018–020 and the matching Edge Functions deploy.
# Set false and rebuild only as an emergency kill switch.
VITE_RECOMMENDATIONS_ENABLED=true

# Released for the owner-only Android beta after the UI16 backend deployment.
# Set false and rebuild to remove the viewer entry point immediately.
VITE_TOPIC_SEARCH_ENABLED=true
