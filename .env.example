# Environment inventory for Riket TV — Appendix A of
# docs/RECOMMENDATION_PREREQUISITES.md. Copy the parts you need to a real file
# and fill them in. `.env` and `.env.*` are gitignored; `.env.example` is not.
#
# WHICH FILE, AND WHY THE REPO ROOT
#
#   .env         Worker / server credentials. Read by pydantic-settings
#                (src/config.py sets env_file=".env"). NEVER committed.
#   .env.local   Frontend values for local `vite` runs. web/vite.config.ts sets
#                envDir: "..", because the InstaPods deploy runs
#                `cd web && vite build` while InstaPods writes its own .env at
#                the pod root. Both files therefore live HERE, not in web/.
#
# Vite only copies variables prefixed VITE_ into the browser bundle, so a
# RIKET_* secret sitting in the same directory is not shipped to clients. That
# is a property of the prefix, not an accident — do not add `envPrefix` overrides
# and do not rename a secret to VITE_*.
#
# ---------------------------------------------------------------------------
# Frontend — public by design, ships in the bundle  (put in .env.local)
# ---------------------------------------------------------------------------

# Supabase project REST URL and the RLS-limited publishable (anon) key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Clerk publishable key (A-6). Development: pk_test_...  Production: pk_live_...
# Leave empty to run with no authentication; the anonymous feed keeps working.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# ---------------------------------------------------------------------------
# Pipeline worker — SECRET, server/local only  (put in .env)
# ---------------------------------------------------------------------------

# Supabase project reference, e.g. nlooigmwuqqhhnontlgp. Not a secret.
RIKET_SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Personal access token for the Supabase Management API. Applies migrations.
# SECRET. Full control of the project.
RIKET_SUPABASE_ACCESS_TOKEN=sbp_YOUR_MANAGEMENT_ACCESS_TOKEN

# Supabase secret (service_role) key. Bypasses RLS. SECRET.
# Used by C11 to call publish_clip_batch. Never in a VITE_* variable.
RIKET_SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Bunny Storage/CDN API key. SECRET.
RIKET_BUNNY_API_KEY=YOUR_BUNNY_API_KEY

# Publish backend: `local` writes file:// artifacts, `remote` uploads to Bunny
# and writes Supabase rows.
RIKET_PUBLISH_BACKEND=local

# C7 title generation. `fallback` uses the deterministic first sentence,
# `ollama` a local model, `api` any OpenAI-compatible provider.
RIKET_TITLE_BACKEND=fallback
RIKET_TITLE_API_BASE_URL=https://api.deepseek.com/v1
RIKET_TITLE_MODEL=deepseek-chat
# SECRET. Never a VITE_* variable.
RIKET_TITLE_API_KEY=sk-YOUR_PROVIDER_KEY
# Published prices, USD per million tokens, for cost reporting only.
RIKET_TITLE_API_INPUT_PER_M=0.14
RIKET_TITLE_API_CACHED_PER_M=0.014
RIKET_TITLE_API_OUTPUT_PER_M=0.28

# ---------------------------------------------------------------------------
# Edge Functions — SECRET, set with `supabase secrets set`, NOT in any file here
# ---------------------------------------------------------------------------
# Listed for the inventory only. These belong to the Supabase project's own
# secret store once F2 deploys a function (O-8).
#
#   CLERK_SECRET_KEY                Clerk Backend API. SECRET.
#   CLERK_WEBHOOK_SIGNING_SECRET    Svix verification for user.deleted (A-14). SECRET.
#   CLERK_DOMAIN                    e.g. leading-seasnail-33.clerk.accounts.dev.
#                                   Not a secret; JWKS is derived from it (A-11).
#   SUPABASE_SERVICE_ROLE_KEY       Injected by the platform. Bypasses RLS —
#                                   the subject must come from the verified JWT.
